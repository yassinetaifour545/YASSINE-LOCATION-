    // 3. EXACT PRICING & WHATSAPP UTILITIES
    function calculateDays(startDate, endDate) {
      if (!startDate || !endDate) return 1;
      const start = new Date(startDate);
      const end = new Date(endDate);
      if (isNaN(start.getTime()) || isNaN(end.getTime())) return 1;
      const diffTime = end.getTime() - start.getTime();
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      return diffDays > 0 ? diffDays : 1;
    }

    function calculateBookingPrice(dailyRate, days, selectedExtraIds) {
      const safeDays = Math.max(1, days);
      const carSubtotal = dailyRate * safeDays;
      const extrasBreakdown = selectedExtraIds
        .map((id) => {
          const extra = AVAILABLE_EXTRAS.find((e) => e.id === id);
          if (!extra) return null;
          return {
            name: extra.name,
            rate: extra.pricePerDay,
            cost: extra.pricePerDay * safeDays
          };
        })
        .filter(Boolean);
      const extrasSubtotal = extrasBreakdown.reduce((sum, item) => sum + item.cost, 0);
      const total = carSubtotal + extrasSubtotal;
      return { days: safeDays, carSubtotal, extrasSubtotal, extrasBreakdown, total };
    }

    function formatWhatsAppPhoneNumber(phone) {
      const clean = (phone || '').replace(/[^\d+]/g, '');
      if (clean.startsWith('+')) return clean.substring(1);
      if (clean.startsWith('00')) return clean.substring(2);
      if (clean.startsWith('0')) return '212' + clean.substring(1);
      if (clean.startsWith('212')) return clean;
      return clean || '212653134372';
    }

    function generateWhatsAppMessage(booking) {
      const days = calculateDays(booking.startDate, booking.endDate);
      const price = calculateBookingPrice(booking.dailyRate, days, booking.selectedExtras);
      const extrasNames = booking.selectedExtras
        .map((id) => {
          const found = AVAILABLE_EXTRAS.find((e) => e.id === id);
          return found ? found.name : null;
        })
        .filter(Boolean)
        .join(', ');
      const extrasText = extrasNames.length > 0 ? extrasNames : 'None (Standard included package)';

      const lines = [
        'Hello YT-LOC! 👋 I would like to book a car rental.',
        '',
        '🚘 Vehicle: ' + booking.carModel + ' (' + booking.dailyRate + ' DH/day)',
        '📅 Dates: ' + booking.startDate + ' to ' + booking.endDate + ' (' + days + ' ' + (days === 1 ? 'day' : 'days') + ')',
        '📍 Pick-up: ' + (booking.pickupLocation || 'Marrakech Airport') + ' at ' + (booking.pickupTime || '10:00'),
        '🏁 Drop-off: ' + (booking.dropoffLocation || 'Marrakech Airport') + ' at ' + (booking.dropoffTime || '10:00'),
        '✨ Extras: ' + extrasText,
        '💰 Estimated Total: ' + price.total + ' DH (Dirhams)',
        '',
        '👤 Customer Name: ' + (booking.customerName || '[Not provided]'),
        '📞 Phone / WhatsApp: ' + (booking.customerPhone || '[Not provided]')
      ];
      if (booking.flightOrNotes) {
        lines.push('📝 Flight/Notes: ' + booking.flightOrNotes);
      }
      lines.push('');
      lines.push('Please confirm vehicle availability and reservation details. Thank you!');
      return lines.join('\n');
    }

    function generateWhatsAppLink(phoneNumber, booking) {
      const cleanPhone = formatWhatsAppPhoneNumber(phoneNumber);
      const message = generateWhatsAppMessage(booking);
      return 'https://wa.me/' + cleanPhone + '?text=' + encodeURIComponent(message);
    }

