      d.setDate(d.getDate() + 5);
      return d.toISOString().split('T')[0];
    })();

    const bookingState = {
      carId: 'dacia-sandero',
      startDate: tomorrowDate,
      endDate: fiveDaysOutDate,
      pickupLocation: MOROCCAN_LOCATIONS[0].name,
      dropoffLocation: MOROCCAN_LOCATIONS[0].name,
      pickupTime: '10:00',
