      const titleEl = document.getElementById('legal-modal-title');
      const bodyEl = document.getElementById('legal-modal-body');
      if (type === 'terms') {
        titleEl.textContent = 'Terms & Conditions';
        bodyEl.innerHTML = `
          <p><strong>1. Driver Requirements:</strong> Minimum driver age is 21 years. Valid national or international driving license held for at least 12 months is mandatory.</p>
          <p><strong>2. Pricing &amp; Currency:</strong> All prices listed are quoted in Moroccan Dirhams (MAD/DH). Payment can be completed upon delivery in MAD, EUR, USD, or credit/debit card.</p>
          <p><strong>3. Fuel Policy:</strong> Vehicles are delivered with a set fuel level and returned with the same level (Like-for-Like).</p>
          <p><strong>4. Unlimited Mileage:</strong> Standard rentals include 100% unlimited mileage within the borders of the Kingdom of Morocco.</p>
          <p><strong>5. WhatsApp Concierge:</strong> All reservations agreed via WhatsApp at 0653134372 are legally binding once confirmed by our operations desk.</p>
        `;
      } else {
        titleEl.textContent = 'Privacy Policy';
        bodyEl.innerHTML = `
          <p><strong>1. Information Collection:</strong> We collect only the details necessary to prepare your vehicle rental agreement (Name, Phone number, Pick-up dates, Flight arrival).</p>
          <p><strong>2. WhatsApp Communication:</strong> Your contact number is used solely to coordinate vehicle handover, delivery logistics, and provide 24/7 customer assistance.</p>
          <p><strong>3. Data Security:</strong> We never sell or share your personal details with third-party advertising brokers. Contact details can be removed upon written request to contact.yass@gmail.com.</p>
        `;
      }
      document.getElementById('legal-modal').classList.remove('hidden');
    }

    function closeLegalModal() {
      document.getElementById('legal-modal').classList.add('hidden');
    }

    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu-dropdown');
      const openIcon = document.getElementById('mobile-menu-icon-open');
      const closeIcon = document.getElementById('mobile-menu-icon-close');
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    }

    function closeMobileMenu() {
      document.getElementById('mobile-menu-dropdown').classList.add('hidden');
      document.getElementById('mobile-menu-icon-open').classList.remove('hidden');
      document.getElementById('mobile-menu-icon-close').classList.add('hidden');
    }

    function toggleFloatingPopup(forceState) {
      const popup = document.getElementById('floating-wa-popup');
      const isHidden = popup.classList.contains('hidden');
      const nextState = (forceState !== undefined) ? forceState : isHidden;
      if (nextState) {
        popup.classList.remove('hidden');
      } else {
        popup.classList.add('hidden');
      }
    }

    // 10. INITIALIZATION ON DOM LOAD
    function initWebsite() {
      // Populate Location Selects
      const locOptionsHtml = MOROCCAN_LOCATIONS.map((loc) =>
        `<option value="${loc.name}">${loc.name}</option>`
      ).join('');
      ['hero-location', 'modal-pickup-loc', 'modal-dropoff-loc', 'page-pickup-loc', 'page-dropoff-loc'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.innerHTML = locOptionsHtml;
      });

      // Populate Car Selects
      const carOptionsHtml = FLEET_CARS.map((c) =>
        `<option value="${c.id}">${c.model} (${c.dailyRate} DH/day)</option>`
      ).join('');
      const switcherOptionsHtml = FLEET_CARS.map((c) =>
        `<option value="${c.id}">Switch: ${c.model} (${c.dailyRate} DH)</option>`
      ).join('');

      document.getElementById('hero-car').innerHTML = carOptionsHtml;
      document.getElementById('page-book-car').innerHTML = carOptionsHtml;
      document.getElementById('modal-car-switcher').innerHTML = switcherOptionsHtml;

      // Set initial dates
      document.getElementById('hero-start-date').value = tomorrowDate;
      document.getElementById('hero-start-date').min = tomorrowDate;

      // Populate Footer Quick Fleet Links
      document.getElementById('footer-fleet-links').innerHTML = FLEET_CARS.map((car) => `
        <button
          type="button"
          onclick="openCarDetailModal('${car.id}')"
          class="hover:text-white transition-colors flex items-center justify-between text-left cursor-pointer"
        >
          <span>${car.model}</span>
          <span class="font-mono-num text-emerald-400">${car.dailyRate} DH</span>
        </button>
      `).join('');

      renderFleet();
      renderFaqs();
      updateAllBookingViews();
    }

    window.addEventListener('DOMContentLoaded', initWebsite);
  </script>
