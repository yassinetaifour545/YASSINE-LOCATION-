    function copyCurrentWhatsAppMessage(statusElId) {
      const text = document.getElementById('modal-whatsapp-preview').textContent;
      const statusEl = document.getElementById(statusElId);
      const showCopied = () => {
        const orig = statusEl.textContent;
        statusEl.textContent = '✓ Copied!';
        setTimeout(() => { statusEl.textContent = orig; }, 2500);
      };

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(showCopied).catch(() => {
          fallbackCopyText(text);
          showCopied();
        });
      } else {
        fallbackCopyText(text);
        showCopied();
      }
    }

    function fallbackCopyText(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
    }

    // 7. CAR DETAIL MODAL
    function openCarDetailModal(carId) {
      const car = FLEET_CARS.find((c) => c.id === carId) || FLEET_CARS[0];
      currentDetailCarId = car.id;
      document.getElementById('detail-car-category').textContent = car.category;
      document.getElementById('car-detail-title').textContent = car.name + ' — ' + car.model;
      document.getElementById('detail-car-img').src = car.image;
      document.getElementById('detail-car-desc').textContent = car.description;
      document.getElementById('detail-car-rec').textContent = '💡 Recommended for: ' + car.recommendedFor;
      document.getElementById('detail-spec-seats').textContent = car.specs.seats + ' Adults';
      document.getElementById('detail-spec-trans').textContent = car.specs.transmission;
      document.getElementById('detail-spec-fuel').textContent = car.specs.fuel;
      document.getElementById('detail-spec-luggage').textContent = car.specs.luggage;
      document.getElementById('detail-spec-consumption').textContent = car.specs.consumption;
      document.getElementById('detail-car-rate').textContent = car.dailyRate + ' DH';
      document.getElementById('detail-book-btn-text').textContent = 'Book this ' + car.model;

      document.getElementById('detail-features-list').innerHTML = car.features.map((feat) => `
        <div class="flex items-center gap-2 text-xs text-slate-700">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>${feat}</span>
        </div>
      `).join('');

      document.getElementById('car-detail-modal').classList.remove('hidden');
    }

    function closeCarDetailModal() {
      document.getElementById('car-detail-modal').classList.add('hidden');
    }

    function bookFromDetailModal() {
      closeCarDetailModal();
      openBookingModal(currentDetailCarId);
    }

    // 8. AI MOROCCAN ROUTE & FLEET ADVISOR (EXACT LOGIC FROM SERVER.TS + FULL 8-CAR MATCHING)
    function computeMoroccanCarRecommendation(query, passengers, luggage) {
      const q = (query || '').toLowerCase();

      if (q.includes('desert') || q.includes('merzouga') || q.includes('atlas') || q.includes('mountain') || passengers >= 4 || luggage >= 3) {
        if (q.includes('luxury') || q.includes('executive') || q.includes('best') || q.includes('power') || q.includes('t-roc') || q.includes('vw')) {
          return {
            recommendedCarId: 'vw-t-roc',
            carName: 'Volkswagen T-Roc (600 DH/day)',
            rationale: 'For demanding terrain across the High Atlas passes and long-distance desert routes, the Volkswagen T-Roc delivers turbocharged torque, German high-speed stability, and commanding ride height.',
            itineraryTips: [
              'Take the scenic N9 route through Tizi n\'Tichka pass during daylight hours for spectacular mountain views.',
              'Stock up on bottled water and download offline maps before heading south towards Ouarzazate and Zagora.',
              'Toll plazas accept cash in Moroccan Dirhams (MAD); keep 50 and 100 DH bills handy.'
            ]
          };
        }
        if (q.includes('360') || q.includes('sunroof') || q.includes('changan')) {
          return {
            recommendedCarId: 'changan-cs35',
            carName: 'Changan CS35 (450 DH/day)',
            rationale: 'The Changan CS35 combines elevated SUV ground clearance with a 360-degree panoramic camera and sunroof, giving your group effortless automatic comfort and panoramic views across Moroccan valleys.',
            itineraryTips: [
              'Use the 360-degree camera when maneuvering tight kasbah parking zones.',
              'Enjoy the panoramic roof through the Dadès and Todra gorges.'
            ]
          };
        }
        return {
          recommendedCarId: 'hyundai-tucson',
          carName: 'Hyundai Tucson (450 DH/day)',
          rationale: 'With an expansive 598L trunk and commanding ground clearance, the Hyundai Tucson effortlessly swallows 4 passenger bags while providing smooth automatic cruising across Moroccan valleys and coastal highways.',
          itineraryTips: [
            'Great ground clearance makes the Tucson ideal for gravel approaches to desert kasbahs and Palmeraies.',
            'High air conditioning performance ensures passenger comfort during warmer midday desert drives.',
            'Speed radars are strictly enforced on the Marrakech-Agadir and Marrakech-Casablanca A3 autoroutes.'
          ]
        };
      }

      if (q.includes('auto') || q.includes('automatic') || q.includes('business')) {
        return {
          recommendedCarId: 'mg-3',
          carName: 'MG 3 Automatic (350 DH/day)',
          rationale: 'The MG 3 offers effortless automatic transmission, compact dimensions for maneuvering crowded city center parking, and sharp responsive handling at an accessible 350 DH/day.',
          itineraryTips: [
            'Ideal for stress-free navigating inside Gueliz (Marrakech) and Maarif (Casablanca).',
            'Automatic transmission removes stop-and-go fatigue during rush hours.'
          ]
        };
      }

      if (q.includes('budget') || q.includes('cheap') || q.includes('econom') || q.includes('value') || q.includes('surf') || q.includes('essaouira')) {
        return {
          recommendedCarId: 'dacia-sandero',
          carName: 'Dacia Sandero Stepway (270 DH/day)',
          rationale: 'At only 270 DH/day with exceptional 4.8L/100km diesel efficiency, the Dacia Sandero Stepway gives you elevated crossover ground clearance, Apple CarPlay, and the best price-to-comfort ratio in Morocco.',
          itineraryTips: [
            'Outstanding fuel economy lets you tour Morocco from Tangier to Essaouira with minimal fuel stops.',
            'Compact footprint makes parking near medina gates (e.g. Bab Doukkala in Marrakech) simple.'
          ]
        };
      }

      if (q.includes('family') || q.includes('luggage') || q.includes('bags') || luggage >= 3) {
        return {
          recommendedCarId: 'dacia-logan',
          carName: 'Dacia Logan (280 DH/day)',
          rationale: 'The Dacia Logan boasts a monumental 528L trunk at just 280 DH/day, easily holding multiple large suitcases while delivering legendary Moroccan durability.',
          itineraryTips: [
            'Unmatched trunk space for souvenirs and oversized baggage.',
            'Very economical diesel engine with widespread serviceability everywhere in Morocco.'
          ]
        };
      }

      if (q.includes('style') || q.includes('peugeot') || q.includes('208') || q.includes('cockpit')) {
        return {
          recommendedCarId: 'peugeot-208',
          carName: 'Peugeot 208 (320 DH/day)',
          rationale: 'The Peugeot 208 combines iconic feline LED styling with a futuristic 3D i-Cockpit and ultra-frugal 4.0L/100km diesel efficiency for stylish coastal and intercity cruising.',
          itineraryTips: [
            'Whisper-quiet cabin acoustics make highway journeys between Rabat, Casablanca, and Marrakech effortless.',
            'Compact sport steering wheel offers agile handling on winding coastal roads.'
          ]
        };
      }

      return {
        recommendedCarId: 'clio-5',
        carName: 'Renault Clio 5 (300 DH/day)',
        rationale: 'The Renault Clio 5 is Morocco\'s favorite premium compact: modern digital instrumentation, refined suspension, and sleek aesthetics suited for both city dinner dates and coastal highway cruising.',
        itineraryTips: [
          'Pure Vision LED headlights provide exceptional visibility on evening intercity drives.',
          'Refined aerodynamics reduce wind noise on the Casablanca-Marrakech-Agadir highway.'
        ]
      };
    }

    function openAiAdvisorModal() {
      document.getElementById('ai-advisor-modal').classList.remove('hidden');
    }

    function closeAiAdvisorModal() {
      document.getElementById('ai-advisor-modal').classList.add('hidden');
    }

    const AI_QUICK_PROMPTS = [
      'Marrakech to Merzouga Sahara Desert (4 adults, mountain passes & sand tracks)',
      'Economical couple roadtrip: Marrakech, Essaouira & Taghazout surf coast',
      'Casablanca business meetings & airport hops (need smooth automatic)',
      'High Atlas mountain villages with large family luggage'
    ];
    function useAiQuickPrompt(idxOrText) {
      const promptText = typeof idxOrText === 'number' ? AI_QUICK_PROMPTS[idxOrText] : idxOrText;
      document.getElementById('ai-query-input').value = promptText;
      runAiRecommendation(promptText);
    }

    function runAiRecommendation(overrideQuery) {
      const queryEl = document.getElementById('ai-query-input');
      const text = (overrideQuery !== undefined ? overrideQuery : queryEl.value).trim();
      if (!text) {
        queryEl.focus();
        return;
      }
      const passengers = Number(document.getElementById('ai-passengers').value) || 2;
      const luggage = Number(document.getElementById('ai-luggage').value) || 2;

      const rec = computeMoroccanCarRecommendation(text, passengers, luggage);
      const car = FLEET_CARS.find((c) => c.id === rec.recommendedCarId) || FLEET_CARS[0];
      currentAiRecommendedCarId = car.id;

      document.getElementById('ai-rec-title').textContent = car.name + ' (' + car.model + ')';
      document.getElementById('ai-rec-rate').textContent = car.dailyRate + ' DH';
      document.getElementById('ai-rec-img').src = car.image;
      document.getElementById('ai-rec-rationale').textContent = rec.rationale;
      document.getElementById('ai-rec-tips').innerHTML = rec.itineraryTips.map((tip) => `
        <li class="flex items-start gap-2">
          <span class="text-emerald-600 font-bold">·</span>
          <span>${tip}</span>
        </li>
      `).join('');
      document.getElementById('ai-rec-book-btn-text').textContent = 'Select & Book ' + car.model;

      document.getElementById('ai-result-container').classList.remove('hidden');
    }

    function selectAiRecommendedCar() {
      closeAiAdvisorModal();
      openBookingModal(currentAiRecommendedCarId);
    }

    // 9. LEGAL MODAL & MOBILE MENU & FLOATING POPUP
